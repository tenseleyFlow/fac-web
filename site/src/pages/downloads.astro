// File type labels
const getFileLabel = (type: string) => {
  switch(type) {
    case 'dmg': return '.dmg Installer';
    case 'pkg': return '.pkg Installer';
    case 'msi': return '.msi Installer';
    case 'exe': return '.exe Installer';
    case 'archive': return 'Archive (.tar.gz)';
    case 'zip': return 'Archive (.zip)';
    default: return 'Download';
  }
};
---

<BaseLayout
  title="Download facsimile - Terminal Text Editor"
  description="Download facsimile terminal text editor. Available in Fortran and Rust versions for Windows, macOS, and Linux. Pre-built binaries and source code."
  keywords="download facsimile, terminal editor download, fortran editor, rust editor, text editor binary, windows terminal editor"
>
  <section>
    <h2 style="margin-top: 0;">Downloads</h2>
    <p>Download pre-built binaries or install via package manager. Both Fortran and Rust versions are available.</p>

    <div class="lang-toggle" id="lang-toggle">
      <button class="lang-btn active" data-lang="fortran">Fortran</button>
      <button class="lang-btn" data-lang="rust">Rust</button>
    </div>

    <!-- Fortran Downloads -->
    <div id="fortran-content" class="lang-content">
      <div class="download-methods">
        <div class="method-toggle">
          <button class="method-btn active" data-method="binary">Binary</button>
          <button class="method-btn" data-method="package">Package Manager</button>
        </div>
      </div>

      <div id="fortran-binary" class="method-content">
        <div class="download-warning" role="note">
          <strong>Windows note:</strong> Windows binaries are currently untested on a real Windows machine and may need extra caution.
        </div>

        {sortedFortran.length === 0 ? (
          <div class="empty-state">
            <p>No releases available yet. Check back soon!</p>
          </div>
        ) : (
          sortedFortran.map((version, index) => (
            <div class="version-card">
              <div class="version-header">
                <span class="version-number">v{version.version}</span>
                <span class="version-date">{new Date(version.date).toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric'
                })}</span>
              </div>

              {version.changelog && (
                <p class="version-changelog">{version.changelog}</p>
              )}

              <!-- Windows Section -->
              {version.platforms?.windows && version.platforms.windows.length > 0 && (
                <div class="platform-section">
                  <div class="platform-header">
                    <span class="platform-icon" set:html={platformIcons.windows} />
                    <span class="platform-name">Windows</span>
                  </div>
                  <div class="download-buttons">
                    {version.platforms.windows.map(file => (
                      <a href={`/releases/fortran/${file.filename}`} class="btn btn-download" download>
                        <span class="file-type">{getFileLabel(file.type)}</span>
                        <span class="file-arch">{file.arch}</span>
                      </a>
                    ))}
                  </div>
                </div>
              )}

              <!-- macOS Section -->
              {version.platforms?.macos && version.platforms.macos.length > 0 && (
                <div class="platform-section">
                  <div class="platform-header">
                    <span class="platform-icon" set:html={platformIcons.macos} />
                    <span class="platform-name">macOS</span>
                  </div>
                  <div class="download-buttons">
                    {version.platforms.macos.filter(f => f.type === 'dmg' || f.type === 'pkg').length > 0 && (
                      <div class="download-group">
                        <span class="group-label">Installers</span>
                        {version.platforms.macos.filter(f => f.type === 'dmg' || f.type === 'pkg').map(file => (
                          <a href={`/releases/fortran/${file.filename}`} class="btn btn-download" download>
                            <span class="file-type">{getFileLabel(file.type)}</span>
                            <span class="file-arch">{file.arch}</span>
                          </a>
                        ))}
                      </div>
                    )}
                    {version.platforms.macos.filter(f => f.type === 'archive' || f.type === 'zip').length > 0 && (
                      <div class="download-group">
                        {version.platforms.macos.filter(f => f.type === 'dmg' || f.type === 'pkg').length > 0 && (
                          <span class="group-label">Archives</span>
                        )}
                        {version.platforms.macos.filter(f => f.type === 'archive' || f.type === 'zip').map(file => (
                          <a href={`/releases/fortran/${file.filename}`} class="btn btn-download" download>
                            <span class="file-type">{getFileLabel(file.type)}</span>
                            <span class="file-arch">{file.arch}</span>
                          </a>
                        ))}
                      </div>
                    )}
                    {version.platforms.macos.filter(f => !['dmg', 'pkg', 'archive', 'zip'].includes(f.type)).map(file => (
                      <a href={`/releases/fortran/${file.filename}`} class="btn btn-download" download>
                        <span class="file-type">{getFileLabel(file.type)}</span>
                        <span class="file-arch">{file.arch}</span>
                      </a>
                    ))}
                  </div>
                </div>
              )}

              <!-- Linux Section -->
              {version.platforms?.linux && version.platforms.linux.length > 0 && (
                <div class="platform-section">
                  <div class="platform-header">
                    <span class="platform-icon" set:html={platformIcons.linux} />
                    <span class="platform-name">Linux</span>
                  </div>
                  <div class="download-buttons">
                    {version.platforms.linux.map(file => (
                      <a href={`/releases/fortran/${file.filename}`} class="btn btn-download" download>
                        <span class="file-type">{getFileLabel(file.type)}</span>
                        <span class="file-arch">{file.arch}</span>
                      </a>
                    ))}
                  </div>
                </div>
              )}
            </div>
          ))
        )}
      </div>

      <div id="fortran-package" class="method-content" style="display: none;">
        <div class="terminal-wrapper">
          <div class="terminal">
            <div class="terminal-header">
              <div class="terminal-controls">
                <button class="control-btn close" aria-label="Collapse"></button>
                <button class="control-btn minimize" aria-label="Minimize"></button>
                <button class="control-btn maximize" aria-label="Maximize"></button>
              </div>
              <div class="terminal-title">Terminal</div>
            </div>
            <div class="terminal-body">
              <div class="terminal-line comment"># Homebrew (macOS)</div>
              <div class="terminal-line command"><span class="prompt">$</span> brew tap FortranGoingOnForty/facsimile</div>
              <div class="terminal-line command"><span class="prompt">$</span> brew install facsimile</div>
              <div class="terminal-line" style="margin-top: 1rem;"></div>
              <div class="terminal-line comment"># AUR (Arch Linux)</div>
              <div class="terminal-line command"><span class="prompt">$</span> yay -S facsimile</div>
              <div class="terminal-line" style="margin-top: 1rem;"></div>
              <div class="terminal-line comment"># RPM (Fedora/RHEL)</div>
              <div class="terminal-line command"><span class="prompt">$</span> sudo dnf config-manager --add-repo https://repos.musicsian.com/musicsian.repo</div>
              <div class="terminal-line command"><span class="prompt">$</span> sudo dnf install facsimile</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Rust Downloads -->
    <div id="rust-content" class="lang-content" style="display: none;">
      <div class="download-methods">
        <div class="method-toggle">
          <button class="method-btn active" data-method="binary">Binary</button>
          <button class="method-btn" data-method="package">Package Manager</button>
        </div>
      </div>

      <div id="rust-binary" class="method-content">
        <div class="download-warning" role="note">
          <strong>Windows note:</strong> Windows binaries are currently untested on a real Windows machine and may need extra caution.
        </div>

        {sortedRust.length === 0 ? (
          <div class="empty-state">
            <p>No pre-built binaries available yet.</p>
            <p style="margin-top: 0.5rem;">Build from source or check back soon for packaged releases.</p>
            <div style="margin-top: 1.5rem;">
              <a href="https://github.com/TenseleyFlow/fackr" class="btn btn-secondary">View Source</a>
            </div>
          </div>
        ) : (
          sortedRust.map((version, index) => (
            <div class="version-card">
              <div class="version-header">
                <span class="version-number">v{version.version}</span>
                <span class="version-date">{new Date(version.date).toLocaleDateString('en-US', {
                  year: 'numeric',
                  month: 'long',
                  day: 'numeric'
                })}</span>
              </div>

              {version.changelog && (
                <p class="version-changelog">{version.changelog}</p>
              )}

              <!-- Windows Section -->
              {version.platforms?.windows && version.platforms.windows.length > 0 ? (
                <div class="platform-section">
                  <div class="platform-header">
                    <span class="platform-icon" set:html={platformIcons.windows} />
                    <span class="platform-name">Windows</span>
                  </div>
                  <div class="download-buttons">
                    {version.platforms.windows.map(file => (
                      <a href={`/releases/rust/${file.filename}`} class="btn btn-download" download>
                        <span class="file-type">{getFileLabel(file.type)}</span>
                        <span class="file-arch">{file.arch}</span>
                      </a>
                    ))}
                  </div>
                </div>
              ) : (
                <div class="platform-section coming-soon-section">
                  <div class="platform-header">
                    <span class="platform-icon" set:html={platformIcons.windows} />
                    <span class="platform-name">Windows</span>
                    <span class="coming-soon-badge">Coming Soon</span>
                  </div>
                </div>
              )}

              <!-- macOS Section -->
              {version.platforms?.macos && version.platforms.macos.length > 0 ? (
                <div class="platform-section">
                  <div class="platform-header">
                    <span class="platform-icon" set:html={platformIcons.macos} />
                    <span class="platform-name">macOS</span>
                  </div>
                  <div class="download-buttons">
                    {version.platforms.macos.map(file => (
                      <a href={`/releases/rust/${file.filename}`} class="btn btn-download" download>
                        <span class="file-type">{getFileLabel(file.type)}</span>
                        <span class="file-arch">{file.arch}</span>
                      </a>
                    ))}
                  </div>
                </div>
              ) : (
                <div class="platform-section coming-soon-section">
                  <div class="platform-header">
                    <span class="platform-icon" set:html={platformIcons.macos} />
                    <span class="platform-name">macOS</span>
                    <span class="coming-soon-badge">Coming Soon</span>
                  </div>
                </div>
              )}

              <!-- Linux Section -->
              {version.platforms?.linux && version.platforms.linux.length > 0 && (
                <div class="platform-section">
                  <div class="platform-header">
                    <span class="platform-icon" set:html={platformIcons.linux} />
                    <span class="platform-name">Linux</span>
                  </div>
                  <div class="download-buttons">
                    {version.platforms.linux.map(file => (
                      <a href={`/releases/rust/${file.filename}`} class="btn btn-download" download>
                        <span class="file-type">{getFileLabel(file.type)}</span>
                        <span class="file-arch">{file.arch}</span>
                      </a>
                    ))}
                  </div>
                </div>
              )}
            </div>
          ))
        )}
      </div>

      <div id="rust-package" class="method-content" style="display: none;">
        <div class="terminal-wrapper">
          <div class="terminal">
            <div class="terminal-header">
              <div class="terminal-controls">
                <button class="control-btn close" aria-label="Collapse"></button>
                <button class="control-btn minimize" aria-label="Minimize"></button>
                <button class="control-btn maximize" aria-label="Maximize"></button>
              </div>
              <div class="terminal-title">Terminal</div>
            </div>
            <div class="terminal-body">
              <div class="terminal-line comment"># Homebrew (macOS)</div>
              <div class="terminal-line command"><span class="prompt">$</span> brew tap TenseleyFlow/fackr</div>
              <div class="terminal-line command"><span class="prompt">$</span> brew install fackr</div>
              <div class="terminal-line" style="margin-top: 1rem;"></div>
              <div class="terminal-line comment"># AUR (Arch Linux)</div>
              <div class="terminal-line command"><span class="prompt">$</span> yay -S fackr</div>
              <div class="terminal-line" style="margin-top: 1rem;"></div>
              <div class="terminal-line comment"># RPM (Fedora/RHEL)</div>
              <div class="terminal-line command"><span class="prompt">$</span> sudo dnf config-manager --add-repo https://repos.musicsian.com/musicsian.repo</div>
              <div class="terminal-line command"><span class="prompt">$</span> sudo dnf install fackr</div>
              <div class="terminal-line" style="margin-top: 1rem;"></div>
              <div class="terminal-line comment"># Build from source</div>
              <div class="terminal-line command"><span class="prompt">$</span> git clone https://github.com/TenseleyFlow/fackr</div>
              <div class="terminal-line command"><span class="prompt">$</span> cd fackr && cargo build --release</div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    .download-methods {
      margin-bottom: 1.5rem;
    }

    .method-toggle {
      display: flex;
      justify-content: center;
      gap: 1rem;
      margin-top: 1.5rem;
      margin-bottom: 1rem;
    }

    .method-btn {
      background: var(--bg-secondary);
      border: 1px solid var(--border);
      font-size: 0.9rem;
      font-weight: 500;
      color: var(--text-muted);
      cursor: pointer;
      padding: 0.5rem 1rem;
      border-radius: 4px;
      transition: all 0.2s;
      font-family: inherit;
    }

    .method-btn:hover {
      border-color: var(--border-light);
      color: var(--text);
    }

    .method-btn.active {
      background: var(--bg-tertiary);
      border-color: var(--text-muted);
      color: var(--text);
    }

    .version-changelog {
      color: var(--text-muted);
      font-size: 0.9rem;
      margin: 0.5rem 0 1.5rem 0;
      line-height: 1.5;
    }

    .download-warning {
      margin-bottom: 1rem;
      padding: 0.9rem 1rem;
      background: color-mix(in srgb, var(--accent) 8%, var(--bg-secondary));
      border: 1px solid color-mix(in srgb, var(--accent) 30%, var(--border));
      border-radius: 8px;
      color: var(--text);
      line-height: 1.5;
    }

    .download-warning strong {
      color: var(--accent);
    }

    .platform-section {
      margin-bottom: 1.5rem;
      padding: 1rem;
      background: var(--bg-secondary);
      border-radius: 8px;
      border: 1px solid var(--border);
    }

    .platform-section:last-child {
      margin-bottom: 0;
    }

    .platform-header {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      margin-bottom: 1rem;
      padding-bottom: 0.75rem;
      border-bottom: 1px solid var(--border);
    }

    .platform-icon {
      display: flex;
      align-items: center;
      color: var(--text-muted);
    }

    .platform-name {
      font-weight: 600;
      font-size: 1rem;
    }

    .download-buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 0.75rem;
    }

    .download-group {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      align-items: center;
    }

    .group-label {
      font-size: 0.75rem;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: 0.05em;
      margin-right: 0.25rem;
      width: 100%;
      margin-bottom: 0.25rem;
    }

    .btn-download {
      display: flex;
      flex-direction: column;
      align-items: center;
      padding: 0.75rem 1.25rem;
      background: var(--bg-tertiary);
      border: 1px solid var(--border);
      border-radius: 6px;
      color: var(--text);
      text-decoration: none;
      transition: all 0.2s;
      min-width: 140px;
    }

    .btn-download:hover {
      border-color: var(--accent);
      background: var(--bg-hover);
      transform: translateY(-1px);
    }

    .file-type {
      font-weight: 500;
      font-size: 0.9rem;
    }

    .file-arch {
      font-size: 0.75rem;
      color: var(--text-muted);
      margin-top: 0.25rem;
    }

    .empty-state {
      text-align: center;
      padding: 3rem;
      color: var(--text-muted);
      background: var(--bg-secondary);
      border: 1px solid var(--border);
      border-radius: 8px;
    }

    .coming-soon {
      text-align: center;
      padding: 1.5rem;
      color: var(--text-muted);
      margin-bottom: 1rem;
    }

    .coming-soon-section {
      opacity: 0.6;
    }

    .coming-soon-section .platform-header {
      border-bottom: none;
      margin-bottom: 0;
      padding-bottom: 0;
    }

    .coming-soon-badge {
      margin-left: auto;
      font-size: 0.75rem;
      font-weight: 500;
      color: var(--text-muted);
      background: var(--bg-tertiary);
      padding: 0.25rem 0.5rem;
      border-radius: 4px;
      text-transform: uppercase;
      letter-spacing: 0.03em;
    }

    .method-content {
      animation: fadeIn 0.3s ease;
    }

    @media (max-width: 600px) {
      .download-buttons {
        flex-direction: column;
      }

      .btn-download {
        width: 100%;
      }
    }
  </style>

  <script>
    // Language toggle
    const langBtns = document.querySelectorAll('.lang-btn');
    const fortranContent = document.getElementById('fortran-content');
    const rustContent = document.getElementById('rust-content');
    const langToggle = document.getElementById('lang-toggle');

    function updateUnderline(activeBtn: Element) {
      if (!langToggle) return;
      const btn = activeBtn as HTMLElement;
      const toggleRect = langToggle.getBoundingClientRect();
      const btnRect = btn.getBoundingClientRect();

      const left = btnRect.left - toggleRect.left;
      const width = btnRect.width;

      langToggle.style.setProperty('--underline-left', `${left}px`);
      langToggle.style.setProperty('--underline-width', `${width}px`);
    }

    // Initialize underline position
    const initialActive = document.querySelector('.lang-btn.active');
    if (initialActive) {
      updateUnderline(initialActive);
    }

    langBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const lang = btn.dataset.lang;

        langBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        updateUnderline(btn);
        langToggle?.classList.remove('fortran', 'rust');
        langToggle?.classList.add(lang!);

        if (lang === 'fortran') {
          fortranContent!.style.display = 'block';
          rustContent!.style.display = 'none';
        } else {
          fortranContent!.style.display = 'none';
          rustContent!.style.display = 'block';
        }
      });
    });

    // Recalculate on resize
    window.addEventListener('resize', () => {
      const active = document.querySelector('.lang-btn.active');
      if (active) updateUnderline(active);
    });

    // Method toggle for Fortran
    const fortranMethodBtns = document.querySelectorAll('#fortran-content .method-btn');
    const fortranBinary = document.getElementById('fortran-binary');
    const fortranPackage = document.getElementById('fortran-package');

    fortranMethodBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const method = (btn as HTMLElement).dataset.method;

        fortranMethodBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        if (method === 'binary') {
          fortranBinary!.style.display = 'block';
          fortranPackage!.style.display = 'none';
        } else {
          fortranBinary!.style.display = 'none';
          fortranPackage!.style.display = 'block';
        }
      });
    });

    // Method toggle for Rust
    const rustMethodBtns = document.querySelectorAll('#rust-content .method-btn');
    const rustBinary = document.getElementById('rust-binary');
    const rustPackage = document.getElementById('rust-package');

    rustMethodBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        const method = (btn as HTMLElement).dataset.method;

        rustMethodBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');

        if (method === 'binary') {
          rustBinary!.style.display = 'block';
          rustPackage!.style.display = 'none';
        } else {
          rustBinary!.style.display = 'none';
          rustPackage!.style.display = 'block';
        }
      });
    });

    // Terminal collapse
    document.querySelectorAll('.control-btn.close').forEach(btn => {
      btn.addEventListener('click', () => {
        const body = btn.closest('.terminal')?.querySelector('.terminal-body');
        body?.classList.toggle('collapsed');
      });
    });
  </script>
</BaseLayout>
