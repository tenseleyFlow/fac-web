---
import BaseLayout from '../layouts/BaseLayout.astro';
import versions from '../../versions.json';

// Sort versions by semantic version, newest first
const sortVersions = (versionList: typeof versions.fortran) => {
  return [...versionList].sort((a, b) => {
    const parseVersion = (v: string) => v.split('.').map(n => parseInt(n, 10));
    const [aMajor, aMinor, aPatch = 0] = parseVersion(a.version);
    const [bMajor, bMinor, bPatch = 0] = parseVersion(b.version);

    if (bMajor !== aMajor) return bMajor - aMajor;
    if (bMinor !== aMinor) return bMinor - aMinor;
    return bPatch - aPatch;
  });
};

const sortedFortran = sortVersions(versions.fortran);
const sortedRust = sortVersions(versions.rust);

// Platform icons
const platformIcons = {
